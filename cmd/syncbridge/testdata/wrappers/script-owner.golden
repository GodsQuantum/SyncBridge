#!/bin/sh
set -eu

fail() {
    printf '%s\n' "$1" >&2
    exit 126
}

single_line() {
    case "$1" in
        *'
'*) return 1 ;;
        *) return 0 ;;
    esac
}

validate_canonical_path() {
    expected_path=$1
    resolved_path=$('/usr/bin/readlink' '-m' '--' "$expected_path") || fail 'path cannot be canonicalized'
    [ "$resolved_path" = "$expected_path" ] || fail 'path is no longer canonical'
}

capture_path_snapshot() {
    snapshot_path=$1
    if [ -e "$snapshot_path" ] || [ -L "$snapshot_path" ]; then
        '/usr/bin/stat' '-c' '%d:%i:%f:%u:%g' '--' "$snapshot_path" || return 1
    else
        printf '%s\n' missing
    fi
}

PATH='/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin'
export PATH
umask 0027
validate_canonical_path '/srv/scripts'
validate_canonical_path '/srv/scripts/backup.sh'
cd '/srv/scripts'

script_path='/srv/scripts/backup.sh'
[ -f "$script_path" ] || fail 'script is not a regular file'
[ -x "$script_path" ] || fail 'script is not executable'
magic=$('/usr/bin/head' '-c' '2' '--' "$script_path") || fail 'script shebang cannot be read'
[ "$magic" = '#!' ] || fail 'script has no shebang'
script_snapshot=$(capture_path_snapshot "$script_path") || fail 'script identity cannot be read'
single_line "$script_snapshot" || fail 'script identity is ambiguous'

file_identity=${script_snapshot#*:*:*:}
case "$file_identity" in
    *:*) ;;
    *) fail 'script owner is malformed' ;;
esac
run_uid=${file_identity%%:*}
run_gid=${file_identity#*:}
case "$run_uid" in ''|*[!0-9]*) fail 'script UID is invalid' ;; esac
case "$run_gid" in ''|*[!0-9]*) fail 'script GID is invalid' ;; esac
[ "$run_uid" != 0 ] && [ "$run_gid" != 0 ] || fail 'script owner may not resolve to root'

passwd_entry=$('/usr/bin/getent' 'passwd' "$run_uid") || fail 'script UID has no host account'
single_line "$passwd_entry" || fail 'script UID has multiple host accounts'
IFS=: read -r run_user _ account_uid account_gid _ run_home run_shell <<EOF
$passwd_entry
EOF
case "$account_uid" in ''|*[!0-9]*) fail 'host account UID is invalid' ;; esac
case "$account_gid" in ''|*[!0-9]*) fail 'host account GID is invalid' ;; esac
[ "$account_uid" = "$run_uid" ] || fail 'host account UID changed'
[ -n "$run_user" ] && [ -n "$run_home" ] && [ -n "$run_shell" ] || fail 'host account is incomplete'
passwd_by_name=$('/usr/bin/getent' 'passwd' "$run_user") || fail 'host account name cannot be resolved'
single_line "$passwd_by_name" || fail 'host account name is ambiguous'
[ "$passwd_by_name" = "$passwd_entry" ] || fail 'host account name and UID disagree'

group_entry=$('/usr/bin/getent' 'group' "$run_gid") || fail 'script GID has no host group'
single_line "$group_entry" || fail 'script GID has multiple host groups'
IFS=: read -r run_group _ group_gid _ <<EOF
$group_entry
EOF
case "$group_gid" in ''|*[!0-9]*) fail 'host group GID is invalid' ;; esac
[ "$group_gid" = "$run_gid" ] || fail 'host group GID changed'
[ -n "$run_group" ] || fail 'host group is incomplete'
group_by_name=$('/usr/bin/getent' 'group' "$run_group") || fail 'host group name cannot be resolved'
single_line "$group_by_name" || fail 'host group name is ambiguous'
[ "$group_by_name" = "$group_entry" ] || fail 'host group name and GID disagree'

validate_canonical_path "$script_path"
final_script_snapshot=$(capture_path_snapshot "$script_path") || fail 'script identity cannot be revalidated'
[ "$final_script_snapshot" = "$script_snapshot" ] || fail 'script changed before privilege drop'
[ -f "$script_path" ] && [ -x "$script_path" ] || fail 'script type changed before privilege drop'

exec '/usr/bin/setpriv' '--reuid' "$run_uid" '--regid' "$run_gid" '--init-groups' '--reset-env' '--' \
    '/usr/bin/env' '-i' '--' \
    "HOME=$run_home" \
    "USER=$run_user" \
    "LOGNAME=$run_user" \
    "SHELL=$run_shell" \
    'BACKUP_KIND=nightly' \
    'LANG=C' \
    'LC_ALL=C' \
    'PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin' \
    'SYNCBRIDGE_DRY_RUN=false' \
    'SYNCBRIDGE_JOB_ID=7' \
    'SYNCBRIDGE_JOB_REVISION=3' \
    'SYNCBRIDGE_RUN_ID=run-1' \
    'SYNCBRIDGE_RUN_ORIGIN=manual' \
    'TZ=UTC' \
    '/srv/scripts/backup.sh' \
    '--target' \
    'daily;$(touch /tmp/pwn)'
